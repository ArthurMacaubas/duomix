{
  "name": "duomix",
  "productName": "DuoMix",
  "private": true,
  "version": "1.2.0",
  "description": "DuoMix: mesa de som para dois microfones sem fio.",
  "author": "Arthur Macaúbas",
  "homepage": "https://github.com/ArthurMacaubas/duomix",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icon": "electron scripts/make-icon.cjs",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.arthurmacaubas.duomix",
    "productName": "DuoMix",
    "copyright": "© 2026 Arthur Macaúbas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "DuoMix-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DuoMix",
      "uninstallDisplayName": "DuoMix",
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "runAfterFinish": true
    }
  }
}
